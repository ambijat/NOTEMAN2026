<Window x:Class="Noteman.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoteMan Desktop"
        Width="1120"
        Height="720"
        MinWidth="900"
        MinHeight="580">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Text="Select a workspace to begin." />
        </StatusBar>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#D0D7DE" BorderThickness="1" Padding="10">
                <StackPanel>
                    <TextBlock Text="Workspace" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Button Content="Choose Workspace" Click="ChooseWorkspace_Click" Margin="0,0,0,8" />
                    <TextBlock x:Name="WorkspacePathText" TextWrapping="Wrap" Foreground="#57606A" Margin="0,0,0,16" />

                    <TextBlock Text="Project" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox x:Name="ProjectNameBox" Text="Thesis Notes" Margin="0,0,0,8" />

                    <TextBlock Text="Note" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox x:Name="NoteTitleBox" Text="Chapter One" Margin="0,0,0,8" />
                    <Button Content="New Note" Click="NewNote_Click" Margin="0,0,0,16" />

                    <TextBlock Text="Source" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox x:Name="SourceBox" Text="Reference..." Margin="0,0,0,8" />

                    <TextBlock Text="Page / Locator" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <DockPanel Margin="0,0,0,16">
                        <Button DockPanel.Dock="Left" Content="-" Width="34" Click="PreviousPage_Click" />
                        <Button DockPanel.Dock="Right" Content="+" Width="34" Click="NextPage_Click" />
                        <TextBox x:Name="LocatorBox" Text="1" HorizontalContentAlignment="Center" />
                    </DockPanel>

                    <Button Content="Paste Clipboard Text" Click="PasteClipboardText_Click" Margin="0,0,0,8" />
                    <Button Content="Clipboard OCR (soon)" Click="ClipboardOcr_Click" Margin="0,0,0,8" />
                    <Button Content="Undo Last Capture" Click="UndoLastCapture_Click" Margin="0,0,0,8" />
                    <Button Content="Export Note" Click="ExportNote_Click" Margin="0,0,0,8" />
                    <Button Content="Clear Typed Draft" Click="ClearTypedDraft_Click" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Typed Draft" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="DraftBox"
                         Grid.Row="1"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="190" />
                </Grid.RowDefinitions>
                <TextBlock Text="Current Note Preview" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="PreviewBox"
                         Grid.Row="1"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />

                <Grid Grid.Row="2" Margin="0,12,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="PromptChoice" SelectedIndex="0">
                        <ComboBoxItem Content="Clean OCR" />
                        <ComboBoxItem Content="Summarize" />
                        <ComboBoxItem Content="Thesis Note" />
                        <ComboBoxItem Content="Paraphrase" />
                        <ComboBoxItem Content="Keywords" />
                    </ComboBox>
                    <Button Grid.Column="1" Content="Copy Prompt" Click="CopyPrompt_Click" Margin="6,0,0,0" />
                    <Button Grid.Column="2" Content="Paste AI Result" Click="PasteAiResult_Click" Margin="6,0,0,0" />
                </Grid>
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="AI Prompt Workbench" FontWeight="SemiBold" />
                        <Button DockPanel.Dock="Right" Content="Save Draft as Fragment" Click="SaveDraftAsFragment_Click" Width="150" />
                    </DockPanel>
                    <TextBox x:Name="PromptBox"
                             Grid.Row="1"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
